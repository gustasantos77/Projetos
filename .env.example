# Banco Neon/PostgreSQL. Use sslmode=verify-full no deploy.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# NextAuth. Gere um segredo forte com: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="troque-por-um-segredo-forte"

# Pluggy. Nunca coloque valores reais no código ou no Git.
PLUGGY_API_KEY="troque-pela-chave-da-pluggy"
PLUGGY_BASE_URL="https://api.pluggy.ai"

# mTLS (Mutual TLS) - Segurança de camada de transporte
# Execute: bash scripts/generate-certs.sh para gerar os certificados
MTLS_ENABLED=false
MTLS_CA_CERT_PATH="certs/ca.crt"
MTLS_SERVER_CERT_PATH="certs/server.crt"
MTLS_SERVER_KEY_PATH="certs/server.key"
MTLS_CLIENT_CERT_PATH="certs/client.crt"
MTLS_CLIENT_KEY_PATH="certs/client.key"
MTLS_CLIENT_P12_PASSWORD="gerado-pelo-script"
